# =========================================================
# Azure OpenAI / Azure AI Foundry
# =========================================================

# API Configuration
AZURE_OPENAI_API_VERSION=2025-03-01-preview # mimimum required API version for AzureResponseClient
AZURE_OPENAI_ENDPOINT=
# Azure OpenAI resource endpoint only, for example:
# https://your-openai-resource.openai.azure.com/
# Do not include /openai/v1/ or /openai/deployments/...
AZURE_COGNITIVE_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Chat deployment
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=

# Embedding deployment
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_MODEL_NAME=


# =========================================================
# Azure AI Search
# =========================================================

# AI services account 
AZURE_AI_SERVICES_ENDPOINT=
AZURE_AI_SERVICES_KEY=

# Azure Search configuration
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_QUERY_KEY=

# index configuration
AZURE_SEARCH_INDEX_NAME=cv-test-index
AZURE_SEARCH_VECTOR_PROFILE_NAME=cv-vector-profile
AZURE_SEARCH_VECTOR_ALGORITHM_NAME=cv-hnsw
AZURE_INDEX_VECTOR_DIMENSION=3072
AZURE_SEARCH_SEMANTIC_CONFIG_NAME=cv-semantic-config

# Retrieval defaults
AZURE_SEARCH_TOP_K=5



# =========================================================
# Azure Cosmos DB
# =========================================================

AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=

# Example: chatbot-db
AZURE_COSMOS_DATABASE_NAME=

# Example: chat_sessions
AZURE_COSMOS_CONTAINER_NAME=




# =========================================================
# Azure Storage Account / Blob Storage
# For raw CV files, documents, processed files
# =========================================================

AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=



# =========================================================
# Chatbot token limits and history configuration
# =========================================================

MAX_CHAT_HISTORY_MESSAGES=10
MAX_HISTORY_TOKENS=120000

# ========================================================
# Tavily websearch plugin configuration
# =========================================================
TAVILY_API_KEY=